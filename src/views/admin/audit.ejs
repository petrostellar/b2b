<h1>ممیزی و رویدادها</h1>
<div class="split-r">
  <div class="table-wrap"><table class="data">
    <thead><tr><th>زمان</th><th>کاربر</th><th>عملیات</th><th>موجودیت</th><th>IP</th></tr></thead>
    <tbody><% rows.forEach(function(a){ %><tr><td class="xs dim"><%= date(a.created_at) %></td>
      <td class="small"><%= a.display_name||'system' %></td><td><span class="badge xs"><%= a.action %></span></td>
      <td class="small dim"><%= a.entity %> #<%= a.entity_id %></td><td class="xs mono dim"><%= a.ip||'' %></td></tr><% }) %></tbody></table></div>
  <div class="panel sticky"><b style="display:block;margin-bottom:12px">Event Catalog</b>
    <% events.forEach(function(e){ %><div class="row-between small" style="padding:6px 0;border-top:1px solid var(--line)">
      <span class="mono xs"><%= e.name %></span><b class="mono"><%= num(e.c) %></b></div><% }) %>
  </div>
</div>
