<h1>کمپین‌های تبلیغاتی</h1>
<div class="split-r">
  <div class="table-wrap"><table class="data">
    <thead><tr><th>نام</th><th>جایگاه</th><th>بودجه</th><th>نمایش</th><th>کلیک</th><th>وضعیت</th><th></th></tr></thead>
    <tbody><% rows.forEach(function(a){ %><tr><td class="small"><b><%= a.name %></b><div class="xs dim"><%= a.headline %></div></td>
      <td><span class="badge xs"><%= a.placement %></span></td><td class="mono"><%= money(a.budget_minor/100) %></td>
      <td class="mono"><%= num(a.impressions) %></td><td class="mono"><%= num(a.clicks) %></td>
      <td><span class="badge <%= tone(a.status) %> xs"><%= a.status %></span></td>
      <td><div class="row" style="gap:3px">
        <form method="post" action="/admin/ads/<%= a.id %>/pause"><button class="btn btn-soft btn-sm">⏸</button></form>
        <form method="post" action="/admin/ads/<%= a.id %>/activate"><button class="btn btn-soft btn-sm">▶</button></form>
        <form method="post" action="/admin/ads/<%= a.id %>/delete"><button class="btn btn-soft btn-sm">✕</button></form></div></td></tr><% }) %></tbody></table></div>
  <form method="post" class="panel sticky"><b style="display:block;margin-bottom:12px">کمپین جدید</b>
    <div class="field"><input name="name" placeholder="نام کمپین" required></div>
    <div class="field"><select name="placement"><% [['hero','صفحه اصلی'],['category','دسته‌بندی'],['feed','فید'],['story','استوری'],['sponsored','نتیجه اسپانسری']].forEach(function(x){ %><option value="<%= x[0] %>"><%= x[1] %></option><% }) %></select></div>
    <div class="field"><input name="headline" placeholder="تیتر" required></div>
    <div class="field"><input name="subtext" placeholder="زیرمتن"></div>
    <div class="field"><input name="link_url" placeholder="https://…"></div>
    <div class="field"><select name="target_category_id"><option value="">همه دسته‌ها</option>
      <% cats.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name_fa %></option><% }) %></select></div>
    <div class="grid g2"><div class="field"><input type="number" name="budget" placeholder="بودجه"></div>
      <div class="field"><select name="model"><option value="flat">Flat</option><option value="cpc">CPC</option><option value="cpm">CPM</option></select></div>
      <div class="field"><input type="date" name="starts_at"></div><div class="field"><input type="date" name="ends_at"></div></div>
    <button class="btn btn-primary btn-block">ایجاد کمپین</button></form>
</div>
