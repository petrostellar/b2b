<div class="section-sm"><div class="wrap">
  <div class="row-between"><h1>کالاهای من</h1><a class="btn btn-primary" href="/sell/new">+ ثبت کالا</a></div>
  <div class="tabs">
    <% [['approved','تأیید شده'],['pending','در انتظار بررسی'],['rejected','رد شده'],['draft','پیش‌نویس'],['expired','منقضی'],['archived','بایگانی']].forEach(function(x){ %>
      <a href="/sell?tab=<%= x[0] %>" class="<%= tab===x[0]?'on':'' %>"><%= x[1] %><span class="count">(<%= num(counts[x[0]]) %>)</span></a>
    <% }) %>
  </div>
  <% if (rows.length) { %>
  <div class="table-wrap"><table class="data">
    <thead><tr><th>کالا</th><th>قیمت</th><th>موجودی</th><th>بازدید</th><th>وضعیت</th><th>عملیات</th></tr></thead>
    <tbody><% rows.forEach(function(l){ %>
      <tr>
        <td><div class="row"><span class="avatar av-40" style="border-radius:8px"><% if(l.cover){ %><img src="<%= l.cover %>"><% } else { %>📦<% } %></span>
          <div><a href="/product/<%= l.slug||l.id %>"><b class="small"><%= l.title||'(بدون عنوان)' %></b></a>
          <div class="xs dim"><%= l.listing_type %> · <%= date(l.created_at) %></div></div></div></td>
        <td class="mono"><%= l.price_on_request?'استعلامی':money(l.price,l.currency) %></td>
        <td class="mono"><%= num(l.inventory) %> <%= l.inventory_unit||'' %></td>
        <td class="mono"><%= num(l.views) %></td>
        <td><span class="badge <%= tone(l.status) %>"><%= statusLabel(l.status) %></span>
          <% if(l.moderation_reason){ %><div class="xs err-text"><%= l.moderation_reason %></div><% } %></td>
        <td><div class="row" style="gap:4px">
          <a class="btn btn-soft btn-sm" href="/sell/<%= l.id %>/wizard/1" title="ویرایش">✎</a>
          <a class="btn btn-soft btn-sm" href="/sell/<%= l.id %>/analytics" title="گزارش">📊</a>
          <a class="btn btn-soft btn-sm" href="/sell/<%= l.id %>/price" title="قیمت">💲</a>
          <a class="btn btn-soft btn-sm" href="/sell/<%= l.id %>/stock" title="موجودی">📦</a>
          <a class="btn btn-soft btn-sm" href="/sell/<%= l.id %>/boost" title="نردبان">🚀</a>
          <form method="post" action="/sell/<%= l.id %>/action" style="display:inline">
            <select name="action" onchange="this.form.submit()" style="min-height:33px;height:33px;font-size:12px;width:auto;padding:0 26px 0 8px">
              <option value="">…</option>
              <% if(l.status==='approved'){ %><option value="pause">توقف</option><% } %>
              <% if(l.status==='paused'){ %><option value="activate">فعال‌سازی</option><% } %>
              <% if(['rejected','need_correction'].includes(l.status)){ %><option value="resubmit">ارسال مجدد</option><% } %>
              <option value="duplicate">کپی</option><option value="archive">بایگانی</option><option value="delete">حذف</option>
            </select></form>
        </div></td>
      </tr>
    <% }) %></tbody></table></div>
  <%- include('../partials/pagination', {page: page, pages: pages}) %>
  <% } else { %><div class="empty-state"><div class="ic">📦</div><h3>موردی در این تب نیست</h3><a class="btn btn-primary" href="/sell/new">ثبت کالا</a></div><% } %>
</div></div>
