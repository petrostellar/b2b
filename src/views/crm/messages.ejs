<div class="section-sm"><div class="wrap">
  <h1 style="font-size:24px"><%= t('nav_messages') %></h1>
  <div class="chat-shell">
    <div class="chat-list">
      <div style="padding:12px 14px;border-bottom:1px solid var(--line)">
        <input placeholder="جستجوی مخاطب…" oninput="document.querySelectorAll('.chat-list .item').forEach(function(e){e.style.display=e.dataset.n.includes(this.value)?'':'none'}.bind(this))">
      </div>
      <% convs.forEach(function(c){ %>
      <a class="item <%= active && active.id===c.id ? 'on':'' %>" href="/messages/<%= c.id %>" data-n="<%= (c.peer_business||c.peer_name||'').toLowerCase() %>">
        <span class="avatar av-40"><% if(c.peer_avatar){ %><img src="<%= c.peer_avatar %>"><% } else { %><%= (c.peer_business||c.peer_name||'?').charAt(0) %><% } %></span>
        <div style="flex:1;min-width:0">
          <div class="row" style="gap:5px"><b class="small truncate"><%= c.peer_business||c.peer_name %></b>
            <% if(c.kyc_ok){ %><span class="badge ok xs">✔</span><% } %></div>
          <div class="xs dim truncate"><%= c.last_message||'—' %></div>
        </div>
        <div style="text-align:end"><div class="xs dim"><%= c.last_message_at?date(c.last_message_at):'' %></div>
          <% if(c.unread){ %><span class="badge err xs"><%= num(c.unread) %></span><% } %></div>
      </a><% }) %>
      <% if(!convs.length){ %><div class="empty-state" style="padding:34px 16px"><div class="ic">✉</div><span class="small">گفتگویی ندارید</span></div><% } %>
    </div>

    <div class="chat-main">
      <% if (active) { %>
        <div class="chat-head">
          <a href="/u/<%= peer.id %>" class="avatar av-40"><% if(peer.avatar){ %><img src="<%= peer.avatar %>"><% } else { %><%= (peer.display_name||'?').charAt(0) %><% } %></a>
          <div style="flex:1;min-width:0">
            <a href="/u/<%= peer.id %>"><b class="small"><%= peer.profile.business_name||peer.display_name %></b></a>
            <div class="xs dim">📍 <%= [peer.profile.city,peer.profile.country].filter(Boolean).join(', ') %> · Trust <%= peer.trust_score %></div>
          </div>
          <% if (canPhone && peer.phone) { %><a class="btn btn-ok btn-sm" href="tel:<%= peer.phone %>">📞</a>
          <% } else { %><a class="btn btn-soft btn-sm" href="/pricing" title="نیازمند عضویت ویژه">🔒 📞</a><% } %>
          <a class="btn btn-soft btn-sm" href="/quotes/new?to=<%= peer.id %><%= active.context_type==='buy_request'?'&rfq='+active.context_id:'' %><%= active.context_type==='listing'?'&listing='+active.context_id:'' %>">📄 پیش‌فاکتور</a>
          <form method="post" action="/messages/<%= active.id %>/report"><input type="hidden" name="reason" value="spam">
            <button class="btn btn-soft btn-sm" title="گزارش">⚑</button></form>
        </div>

        <% if (context) { %>
        <div style="padding:10px 18px;border-bottom:1px solid var(--line);background:var(--glass)">
          <div class="row small">
            <span class="badge info xs"><%= active.context_type==='listing'?'کالا':'درخواست خرید' %></span>
            <a href="<%= active.context_type==='listing' ? '/product/'+(context.slug||context.id) : '/buy-requests/'+context.id %>" class="truncate"><%= context.title %></a>
            <span class="spacer"></span>
            <% if(context.price){ %><b class="gold"><%= money(context.price, context.currency) %></b><% } %>
            <% if(context.quantity){ %><b><%= num(context.quantity) %> <%= context.unit||'' %></b><% } %>
          </div>
        </div><% } %>

        <div class="chat-body">
          <% if(!messages.length){ %>
            <div class="center dim small" style="margin:auto;max-width:420px">
              <div style="font-size:40px">👋</div>
              <p>گفتگو را با یک معرفی کوتاه تجاری شروع کنید: نام شرکت، محصول، قیمت، موجودی و شرایط.</p>
            </div>
          <% } %>
          <% messages.forEach(function(m){ %>
            <div class="bubble <%= m.sender_id===user.id?'me':'them' %>">
              <% if(m.attachment){ %>
                <% if(m.attachment_kind==='image'){ %><img src="<%= m.attachment %>" style="border-radius:9px;max-width:230px;margin-bottom:6px">
                <% } else { %><a href="<%= m.attachment %>" class="small">📎 پیوست</a><% } %>
              <% } %>
              <% if(m.body){ %><div><%= m.body %></div><% } %>
              <div class="tm"><%= date(m.created_at) %> <%= m.sender_id===user.id && m.read_at ? '✓✓':'' %></div>
            </div>
          <% }) %>
        </div>

        <form class="chat-compose" method="post" action="/messages/<%= active.id %>" enctype="multipart/form-data">
          <label class="icon-btn" style="cursor:pointer">📎<input type="file" name="attachment" hidden></label>
          <input name="body" placeholder="پیام تجاری خود را بنویسید…" autocomplete="off" style="flex:1">
          <button class="btn btn-primary">ارسال</button>
        </form>
        <script>window.__CONV_ID=<%= active.id %>;window.__LAST_MSG=<%= messages.length?messages[messages.length-1].id:0 %>;</script>
      <% } else { %>
        <div class="empty-state" style="margin:auto">
          <div class="ic">💬</div><h3>گفتگویی انتخاب نشده</h3>
          <p class="small">از فهرست کناری یک گفتگو انتخاب کنید یا از صفحه کالا/درخواست، گفتگوی جدید آغاز کنید.</p>
          <% if (suggested && suggested.length) { %>
            <div style="margin-top:20px;text-align:start;max-width:420px">
              <b class="small">خریداران پیشنهادی</b>
              <% suggested.forEach(function(s){ %>
              <div class="row-between" style="padding:8px 0;border-top:1px solid var(--line)">
                <a href="/u/<%= s.id %>" class="row"><span class="avatar av-32"><%= (s.business_name||s.display_name||'B').charAt(0) %></span>
                  <span class="small"><%= s.business_name||s.display_name %></span></a>
                <a class="btn btn-soft btn-sm" href="/messages/start?user=<%= s.id %>">پیام</a>
              </div><% }) %>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div></div>
