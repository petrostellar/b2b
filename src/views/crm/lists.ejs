<div class="section-sm"><div class="wrap">
  <div class="row-between"><div><span class="eyebrow">CRM LITE</span><h1 style="margin:0">کاربران ذخیره‌شده و لیست‌ها</h1></div></div>
  <div class="split">
    <aside class="panel sticky">
      <b style="display:block;margin-bottom:12px">لیست‌ها</b>
      <% lists.forEach(function(L){ %>
      <a href="/crm?list=<%= L.id %>" class="row-between small" style="padding:8px 0;border-top:1px solid var(--line);<%= activeId===L.id?'color:var(--accent);font-weight:700':'' %>">
        <span>● <%= L.name %></span><span class="dim xs"><%= num(L.cnt) %></span></a><% }) %>
      <form method="post" action="/crm/lists" style="margin-top:14px">
        <div class="field"><input name="name" placeholder="نام لیست جدید" required></div>
        <button class="btn btn-ghost btn-block btn-sm">+ ساخت لیست</button></form>
      <% if (activeId) { %>
      <form method="post" action="/crm/lists/<%= activeId %>/rename" style="margin-top:10px">
        <div class="field"><input name="name" placeholder="نام جدید"></div>
        <button class="btn btn-soft btn-block btn-sm">تغییر نام</button></form>
      <form method="post" action="/crm/lists/<%= activeId %>/delete" style="margin-top:8px">
        <button class="btn btn-danger btn-block btn-sm">حذف لیست</button></form>
      <% } %>
    </aside>
    <div>
      <div class="panel">
        <div class="panel-head"><h3 style="margin:0">اعضای لیست</h3><span class="badge info"><%= num(members.length) %></span></div>
        <% if (members.length) { %>
        <div class="table-wrap"><table class="data">
          <thead><tr><th>کاربر</th><th>وضعیت</th><th>آخرین یادداشت</th><th>عملیات</th></tr></thead>
          <tbody><% members.forEach(function(m){ %>
            <tr><td><a href="/crm/user/<%= m.target_user_id %>" class="row"><span class="avatar av-32"><%= (m.business_name||m.display_name||'?').charAt(0) %></span>
              <div><b class="small"><%= m.business_name||m.display_name %></b><div class="xs dim"><%= [m.city,m.country].filter(Boolean).join(', ') %></div></div>
              <% if(m.kyc_ok){ %><span class="badge ok xs">✔</span><% } %></a></td>
            <td><form method="post" action="/crm/member/<%= m.id %>/status"><select name="status" onchange="this.form.submit()" style="min-height:32px;height:32px;font-size:12px;width:auto;padding:0 26px 0 8px">
              <% crmStatuses.forEach(function(x){ %>
              <option value="<%= x[0] %>" <%= m.status===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></form></td>
            <td class="small dim clamp2" style="max-width:220px"><%= m.last_note||'—' %></td>
            <td><div class="row" style="gap:4px">
              <a class="btn btn-soft btn-sm" href="/messages/start?user=<%= m.target_user_id %>">💬</a>
              <a class="btn btn-soft btn-sm" href="/crm/user/<%= m.target_user_id %>">📝</a>
              <form method="post" action="/crm/member/<%= m.id %>/remove"><button class="btn btn-soft btn-sm">✕</button></form>
            </div></td></tr>
          <% }) %></tbody></table></div>
        <% } else { %><div class="empty-state"><div class="ic">⭐</div>لیست خالی است. از صفحه پروفایل فروشنده/خریدار «ذخیره در لیست» را بزنید.</div><% } %>
      </div>

      <div class="panel" style="margin-top:20px">
        <div class="panel-head"><h3 style="margin:0">کالاهای ذخیره‌شده</h3></div>
        <% if (savedListings.length) { %>
        <div class="grid g4"><% savedListings.forEach(function(l){ %>
          <a class="card card-hover" href="/product/<%= l.slug||l.id %>">
            <div style="aspect-ratio:4/3;background:var(--surface-2)"><% if(l.cover){ %><img src="<%= l.cover %>" style="width:100%;height:100%;object-fit:cover"><% } %></div>
            <div style="padding:10px"><div class="small clamp2"><%= l.title %></div><div class="gold small bold"><%= money(l.price,l.currency) %></div></div></a>
        <% }) %></div>
        <% } else { %><div class="small dim">کالای ذخیره‌شده‌ای ندارید.</div><% } %>
      </div>
    </div>
  </div>
</div></div>
