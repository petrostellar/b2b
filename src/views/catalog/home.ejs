<section class="hero">
  <div class="wrap inner">
    <div class="split-r" style="grid-template-columns:1.15fr .85fr;gap:46px;align-items:center">
      <div>
        <span class="eyebrow">B2B · B2C · C2C · EXPORT</span>
        <h1><%= t('hero_title') %></h1>
        <p style="font-size:17px;max-width:560px"><%= t('hero_sub') %></p>

        <form class="hero-search" method="get" action="/search">
          <select name="category_id">
            <option value=""><%= t('cat_all') %></option>
            <% cats.forEach(function(c){ %><option value="<%= c.id %>"><%= pick(c,'name') %></option><% }) %>
          </select>
          <input name="q" placeholder="<%= t('search_placeholder') %>">
          <button class="btn btn-primary"><%= t('search') %></button>
        </form>

        <div class="row" style="margin-top:22px">
          <a class="btn btn-primary btn-lg" href="/sell/new"><%= t('hero_cta1') %></a>
          <a class="btn btn-ghost btn-lg" href="/buy-requests/new"><%= t('hero_cta2') %></a>
        </div>

        <div class="row" style="margin-top:24px;gap:8px">
          <span class="badge">🔐 Escrow ready</span>
          <span class="badge">✔ Verified suppliers</span>
          <span class="badge">🌍 4 languages</span>
          <span class="badge">📄 RFQ & Quotes</span>
        </div>
      </div>

      <div>
        <div class="stats">
          <div><div class="v mono"><%= num(stats.suppliers) %>+</div><div class="k"><%= t('stat_suppliers') %></div></div>
          <div><div class="v mono"><%= num(stats.listings) %>+</div><div class="k"><%= t('stat_listings') %></div></div>
          <div><div class="v mono"><%= num(stats.requests) %>+</div><div class="k"><%= t('stat_requests') %></div></div>
          <div><div class="v mono"><%= num(stats.countries) %>+</div><div class="k"><%= t('stat_countries') %></div></div>
        </div>
        <% if (featured.length) { %>
        <div class="card card-pad" style="margin-top:18px">
          <div class="row-between" style="margin-bottom:12px"><b class="small"><%= t('featured') %></b><a href="/products?featured=1" class="xs gold"><%= t('view_all') %> →</a></div>
          <% featured.slice(0,3).forEach(function(l){ %>
          <a href="/product/<%= l.slug||l.id %>" class="row" style="padding:9px 0;border-top:1px solid var(--line)">
            <span class="avatar av-40" style="border-radius:10px"><% if(l.cover){ %><img src="<%= l.cover %>"><% } else { %>📦<% } %></span>
            <span style="flex:1;min-width:0"><span class="small truncate" style="display:block"><%= l.title %></span>
              <span class="xs gold"><%= money(l.price, l.currency) %></span></span>
          </a><% }) %>
        </div><% } %>
      </div>
    </div>
  </div>
</section>

<% if (stories.length) { %>
<section class="section-sm"><div class="wrap">
  <div class="row-between"><h3 style="margin:0"><%= t('nav_stories') %></h3><a href="/stories" class="small gold"><%= t('view_all') %> →</a></div>
  <div class="story-rail">
    <% stories.forEach(function(s){ %>
    <a class="story-item" href="/stories/<%= s.id %>">
      <div class="story-ring"><% if (s.media_path) { %><img src="<%= s.media_path %>" alt=""><% } else { %><div class="ph">🎬</div><% } %></div>
      <div class="nm truncate"><%= s.display_name %></div>
    </a><% }) %>
  </div>
</div></section>
<% } %>

<section class="section-sm"><div class="wrap">
  <div class="row-between" style="margin-bottom:20px">
    <div><span class="eyebrow">CATEGORIES</span><h2 style="margin:0"><%= t('cat_title') %></h2></div>
    <a class="btn btn-ghost btn-sm" href="/categories"><%= t('cat_all') %> →</a>
  </div>
  <div class="grid g6">
    <% cats.forEach(function(c){ %>
    <a class="cat-tile anim" href="/category/<%= c.slug %>">
      <div class="ic"><%= c.icon || '📦' %></div>
      <div class="nm"><%= pick(c,'name') %></div>
      <div class="ct"><%= num(c.cnt) %> <%= t('nav_products') %></div>
    </a><% }) %>
  </div>
</div></section>

<% if (ads.length) { %>
<section class="section-sm"><div class="wrap"><div class="grid g3">
  <% ads.forEach(function(a){ %>
  <a class="card card-pad card-hover" href="/ads/<%= a.id %>/click" style="background:var(--hero)">
    <span class="badge muted xs">Ad</span>
    <h3 style="margin:10px 0 6px"><%= a.headline %></h3>
    <p class="small" style="margin:0"><%= a.subtext %></p>
  </a><% }) %>
</div></div></section>
<% } %>

<section class="section"><div class="wrap">
  <div class="row-between" style="margin-bottom:20px">
    <div><span class="eyebrow">TRENDING</span><h2 style="margin:0"><%= t('trending') %></h2></div>
    <a class="btn btn-ghost btn-sm" href="/products?sort=popular"><%= t('view_all') %> →</a>
  </div>
  <div class="grid g4"><% trending.forEach(function(l){ %><%- include('../partials/pcard', {l:l}) %><% }) %></div>
  <% if(!trending.length){ %><div class="empty-state"><div class="ic">📭</div><%= t('empty') %></div><% } %>
</div></section>

<section class="section-sm"><div class="wrap">
  <div class="row-between" style="margin-bottom:20px">
    <div><span class="eyebrow">TRUSTED</span><h2 style="margin:0"><%= t('verified_suppliers') %></h2></div>
    <a class="btn btn-ghost btn-sm" href="/suppliers"><%= t('view_all') %> →</a>
  </div>
  <div class="grid g3">
    <% suppliers.forEach(function(s){ %>
    <a class="card card-pad card-hover anim" href="/u/<%= s.id %>">
      <div class="row">
        <span class="avatar av-56"><% if(s.avatar){ %><img src="<%= s.avatar %>"><% } else { %><%= (s.business_name||s.display_name||'S').charAt(0) %><% } %></span>
        <div style="flex:1;min-width:0">
          <div class="row" style="gap:6px"><b class="truncate"><%= s.business_name || s.display_name %></b>
            <% if (s.kyc_ok) { %><span class="badge ok xs">✔ <%= t('verified') %></span><% } %></div>
          <div class="xs dim">📍 <%= s.city||'' %> <%= s.country||'' %> · <%= s.seller_type||'' %></div>
        </div>
      </div>
      <p class="small clamp2" style="margin:12px 0 10px;min-height:2.8em"><%= s.about || '—' %></p>
      <div class="row xs dim" style="border-top:1px solid var(--line);padding-top:10px">
        <span><%= num(s.listing_count) %> <%= t('nav_products') %></span>
        <% if (s.rating) { %><span class="gold">★ <%= s.rating %></span><% } %>
        <span class="spacer"></span><span>Trust <%= s.trust_score %></span>
      </div>
    </a><% }) %>
  </div>
</div></section>

<section class="section"><div class="wrap">
  <div class="row-between" style="margin-bottom:20px">
    <div><span class="eyebrow">DEMAND</span><h2 style="margin:0"><%= t('latest_requests') %></h2></div>
    <a class="btn btn-ghost btn-sm" href="/buy-requests"><%= t('view_all') %> →</a>
  </div>
  <div class="grid g3">
    <% requests.forEach(function(b){ %>
    <a class="card card-pad card-hover anim" href="/buy-requests/<%= b.id %>">
      <div class="row-between"><span class="badge info xs"><%= pick(b,'cat_name') || 'RFQ' %></span><span class="xs dim"><%= date(b.created_at) %></span></div>
      <h3 style="margin:12px 0 6px;font-size:16px" class="clamp2"><%= b.title %></h3>
      <div class="small muted">🔢 <%= num(b.quantity) %> <%= b.unit||'' %> <% if(b.target_price){ %>· 🎯 <%= money(b.target_price, b.currency) %><% } %></div>
      <div class="row xs dim" style="border-top:1px solid var(--line);padding-top:10px;margin-top:12px">
        <span class="avatar av-24"><%= (b.buyer_name||'B').charAt(0) %></span>
        <span><%= b.buyer_name %></span><span class="spacer"></span><span>📍 <%= b.destination || b.city || '' %></span>
      </div>
    </a><% }) %>
  </div>
</div></section>

<section class="section-sm"><div class="wrap">
  <div class="grid g4">
    <% [['🔒','پرداخت امن و امانی','وجه تا تأیید دریافت کالا نزد پلتفرم نگهداری می‌شود.'],
        ['✔','تأمین‌کننده احراز شده','KYC و KYB با بررسی مدارک حقیقی و حقوقی.'],
        ['📄','RFQ و پیش‌فاکتور','مذاکره نسخه‌بندی‌شده با تاریخچه کامل.'],
        ['🌍','تجارت بین‌المللی','اینکوترمز، حمل و اسناد صادراتی.']].forEach(function(x){ %>
    <div class="card card-pad anim">
      <div style="font-size:26px"><%= x[0] %></div>
      <b style="display:block;margin:8px 0 4px"><%= x[1] %></b>
      <div class="small dim"><%= x[2] %></div>
    </div><% }) %>
  </div>
</div></section>

<% if (fresh.length) { %>
<section class="section"><div class="wrap">
  <div class="row-between" style="margin-bottom:20px"><h2 style="margin:0">New arrivals</h2>
    <a class="btn btn-ghost btn-sm" href="/products?sort=newest"><%= t('view_all') %> →</a></div>
  <div class="grid g4"><% fresh.forEach(function(l){ %><%- include('../partials/pcard', {l:l}) %><% }) %></div>
</div></section>
<% } %>

<% if (posts.length) { %>
<section class="section-sm"><div class="wrap">
  <div class="row-between" style="margin-bottom:20px"><h2 style="margin:0"><%= t('nav_blog') %></h2><a href="/blog" class="small gold"><%= t('view_all') %> →</a></div>
  <div class="grid g3">
    <% posts.forEach(function(p){ %>
    <a class="card card-hover anim" href="/blog/<%= p.slug %>">
      <div style="aspect-ratio:16/9;background:var(--hero);display:grid;place-items:center;font-size:32px">📰</div>
      <div class="card-pad"><b class="clamp2"><%= p.title %></b><p class="small clamp2" style="margin:8px 0 0"><%= p.excerpt %></p></div>
    </a><% }) %>
  </div>
</div></section>
<% } %>
