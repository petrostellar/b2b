<div class="section-sm"><div class="wrap">
  <nav class="breadcrumb"><a href="/"><%= t('nav_home') %></a> › <a href="/buy-requests"><%= t('nav_requests') %></a> › <span class="gold truncate" style="max-width:260px"><%= b.title %></span></nav>
  <div class="split-r">
    <div>
      <div class="panel">
        <div class="row" style="gap:7px;margin-bottom:10px">
          <span class="badge <%= tone(b.status) %>"><%= statusLabel(b.status) %></span>
          <span class="badge info"><%= pick(b,'cat_name') %></span>
          <% if(b.kyc_ok){ %><span class="badge ok">✔ خریدار احراز شده</span><% } %>
          <% if(b.wholesale_experience){ %><span class="badge">سابقه خرید عمده</span><% } %>
        </div>
        <h1 style="font-size:26px"><%= b.title %></h1>
        <div class="row small dim"><span>👁 <%= num(b.views_count) %></span><span>📄 <%= num(b.quote_count) %> پیشنهاد</span><span>🕓 <%= date(b.created_at) %></span></div>
        <hr>
        <dl class="kv">
          <% [['نوع/واریته',b.variety],['مقدار مورد نیاز', num(b.quantity)+' '+(b.unit||'')],
              ['قیمت هدف', b.target_price?money(b.target_price,b.currency):null],
              ['مبدأ ترجیحی',b.origin_preference],['مقصد تحویل',b.destination],
              ['مهلت', b.deadline?date(b.deadline):null],
              ['الزامات بسته‌بندی',b.packaging_requirement],['الزامات کیفیت',b.quality_requirement],
              ['گواهی‌های لازم',b.certificate_requirement],['روش تماس',b.contact_preference]].forEach(function(x){ if(x[1]){ %>
            <dt><%= x[0] %></dt><dd><%= x[1] %></dd><% }}) %>
        </dl>
        <hr>
        <h3>توضیحات</h3><p style="white-space:pre-wrap"><%= b.description %></p>
        <% if(b.attachment){ %><a class="btn btn-ghost btn-sm" href="<%= b.attachment %>">📎 دانلود پیوست</a><% } %>
      </div>

      <!-- QUOTES -->
      <div class="panel" style="margin-top:20px">
        <div class="panel-head"><h3 style="margin:0">پیشنهادهای دریافتی (<%= num(quotes.length) %>)</h3></div>
        <% if (owner) { %>
          <% if (quotes.length) { %>
          <div class="table-wrap"><table class="data">
            <thead><tr><th>فروشنده</th><th>قیمت</th><th>مقدار</th><th>اینکوترمز</th><th>اعتبار</th><th>وضعیت</th><th></th></tr></thead>
            <tbody><% quotes.forEach(function(qt){ %>
              <tr><td><a href="/u/<%= qt.seller_id %>" class="row"><span class="avatar av-32"><%= (qt.business_name||qt.seller_name||'S').charAt(0) %></span>
                <span class="small"><%= qt.business_name||qt.seller_name %></span><% if(qt.kyc_ok){ %><span class="badge ok xs">✔</span><% } %></a></td>
              <td class="mono gold"><%= money(qt.price,qt.currency) %></td><td class="mono"><%= num(qt.quantity) %></td>
              <td><%= qt.incoterm||'—' %></td><td class="small"><%= qt.valid_until?date(qt.valid_until):'—' %></td>
              <td><span class="badge <%= tone(qt.status) %>"><%= statusLabel(qt.status) %></span></td>
              <td><div class="row" style="gap:4px">
                <a class="btn btn-soft btn-sm" href="/quotes/<%= qt.id %>">جزئیات</a>
                <% if(b.status!=='awarded'){ %>
                <form method="post" action="/buy-requests/<%= b.id %>/award/<%= qt.id %>"><button class="btn btn-ok btn-sm">پذیرش</button></form><% } %>
              </div></td></tr>
            <% }) %></tbody></table></div>
          <% } else { %><div class="empty-state"><div class="ic">📄</div>هنوز پیشنهادی دریافت نشده است.</div><% } %>
        <% } else { %>
          <p class="small dim">فقط خریدار می‌تواند پیشنهادهای دریافتی را ببیند. پیشنهاد شما به صورت خصوصی ارسال می‌شود.</p>
        <% } %>
      </div>
    </div>

    <aside class="sticky">
      <div class="panel">
        <a href="/u/<%= b.buyer_id %>" class="row">
          <span class="avatar av-56"><% if(b.buyer_avatar){ %><img src="<%= b.buyer_avatar %>"><% } else { %><%= (b.business_name||b.buyer_name||'B').charAt(0) %><% } %></span>
          <div style="min-width:0"><b class="truncate" style="display:block"><%= b.business_name||b.buyer_name %></b>
            <div class="xs dim">📍 <%= [b.city,b.country].filter(Boolean).join(', ') %></div></div></a>
        <div class="row" style="margin:12px 0;gap:6px"><span class="badge xs">Trust <%= b.trust_score %></span>
          <% if(b.kyc_ok){ %><span class="badge ok xs">✔ <%= t('verified') %></span><% } %></div>

        <% if (owner) { %>
          <div class="col">
            <a class="btn btn-ghost btn-block" href="/my-requests">درخواست‌های من</a>
            <% if(b.status!=='closed'){ %>
            <form method="post" action="/buy-requests/<%= b.id %>/close"><button class="btn btn-danger btn-block">بستن درخواست</button></form><% } %>
          </div>
        <% } else if (user) { %>
          <div class="col">
            <a class="btn btn-primary btn-block" href="/quotes/new?rfq=<%= b.id %>">📄 ارسال پیشنهاد قیمت</a>
            <a class="btn btn-ghost btn-block" href="/messages/start?user=<%= b.buyer_id %>&rfq=<%= b.id %>">💬 گفتگو با خریدار</a>
            <% if (canPhone) { %><a class="btn btn-ok btn-block" href="tel:#">📞 تماس</a>
            <% } else { %><a class="btn btn-soft btn-block" href="/pricing">🔓 شماره خریدار (عضویت ویژه)</a><% } %>
            <button class="btn btn-soft btn-block" data-bookmark="user:<%= b.buyer_id %>">☆ ذخیره خریدار</button>
          </div>
          <% if (myQuote) { %><div class="alert info" style="margin-top:12px">شما قبلاً پیشنهاد ارسال کرده‌اید — <a href="/quotes/<%= myQuote.id %>" class="gold">مشاهده</a></div><% } %>
        <% } else { %>
          <a class="btn btn-primary btn-block" href="/auth/login">برای ارسال پیشنهاد وارد شوید</a>
        <% } %>
      </div>

      <div class="panel" style="margin-top:18px">
        <b style="display:block;margin-bottom:10px">تأمین‌کنندگان پیشنهادی</b>
        <% sellers.forEach(function(s){ %>
        <a href="/u/<%= s.id %>" class="row" style="padding:7px 0;border-top:1px solid var(--line)">
          <span class="avatar av-32"><%= (s.business_name||s.display_name||'S').charAt(0) %></span>
          <div style="min-width:0"><div class="small truncate"><%= s.business_name||s.display_name %></div>
          <div class="xs dim"><%= num(s.lc) %> کالا</div></div>
          <% if(s.kyc_ok){ %><span class="badge ok xs">✔</span><% } %></a><% }) %>
      </div>
    </aside>
  </div>
</div></div>
